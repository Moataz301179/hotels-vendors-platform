  baseRateEgp     Float?
  perKgRateEgp    Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  uuid            String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt       DateTime?

  @@index([corridorName])
}

model DockSlot {
  id            String    @id @default(cuid())
  slotId        String    @unique
  tenantId      String
  hotelId       String
  hotelName     String?
  date          String
  startTime     String
  endTime       String
  orderId       String?
  carrierName   String?
  driverName    String?
  vehicleNumber String?
  status        String    @default("AVAILABLE")
  geofenceAlert Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  uuid          String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt     DateTime?

  @@index([date])
  @@index([hotelId])
  @@index([status])
  @@index([tenantId])
}

model ConsumptionForecast {
  id                         String   @id @default(cuid())
  tenantId                   String
  hotelId                    String
  productId                  String
  month                      String
  year                       Int
  monthNum                   Int
  occupancyRate              Float
  avgDailyConsumption        Float
  totalConsumption           Float
  monthlyForecast            Float
  forecastAccuracy           Float?
  consumptionPerRoom         Float
  consumptionPerOccupiedRoom Float
  trendDirection             String   @default("STABLE")
  seasonalityFactor          Float    @default(1.0)
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  hotel                      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  product                    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, hotelId, productId, month])
  @@index([hotelId])
  @@index([month])
  @@index([productId])
  @@index([tenantId])
}

model ProductVariation {
  id            String    @id @default(cuid())
  productId     String
  sku           String    @unique
  name          String
  variantType   String
  variantValue  String
  unitPrice     Decimal?  @db.Decimal(12, 2)
  stockQuantity Int       @default(0)
  minOrderQty   Int       @default(1)
  barcode       String?
  weight        Float?
  dimensions    String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  uuid          String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt     DateTime?
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
  @@index([variantType])
}

enum CarrierStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum ReconciliationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ADJUSTED
}

enum RfqStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  BI_WEEKLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SupportTicketCategory {
  BILLING
  TECHNICAL
  ORDER
  SUPPLIER
  FACTORING
  ETA
  OTHER
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PricingMode {
  FIXED
  RFQ
  HYBRID
}

enum ProductSource {
  FIXTURE
  SUPPLIER_SYNC
  ECOMMERCE
  DROPSHIP
  MANUAL
}
