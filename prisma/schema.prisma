  overallStatus OnboardingStatus @default(IN_PROGRESS)
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  uuid          String?          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt     DateTime?
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([tenantId])
  @@index([userId])
}

model CarrierProfile {
  id                    String        @id @default(cuid())
  userId                String        @unique
  tenantId              String
  city                  String
  governorate           String
  address               String?
  taxId                 String?
  vehicleCount          Int           @default(1)
  zones                 String[]
  vehicleTypes          String[]
  maxWeight             Float?
  temperatureControlled Boolean       @default(false)
  rating                Float         @default(0)
  reviewCount           Int           @default(0)
  status                CarrierStatus @default(PENDING_VERIFICATION)
  verifiedAt            DateTime?
  verifiedBy            String?
  insuranceExpiry       DateTime?
  licenseExpiry         DateTime?
  documents             String[]
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  uuid                  String?       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt             DateTime?
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([status])
  @@index([tenantId])
}

model Shipment {
  id               String    @id @default(cuid())
  tenantId         String
  orderIds         String[]
  corridor         String
  truckType        String
  vehicleNumber    String?
  driverName       String?
  driverMobile     String?
  originHub        String
  destinationHub   String
  dispatchDate     DateTime?
  estimatedArrival DateTime?
  totalWeightKg    Float?
  orderCount       Int       @default(0)
  status           String    @default("PLANNED")
  waybillId        String?
  qrCode           String?
  savingsPercent   Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  uuid             String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt        DateTime?

  @@index([corridor])
  @@index([status])
  @@index([tenantId])
}

model CorridorRoute {
  id              String    @id @default(cuid())
  corridorName    String    @unique
  scheduleDays    String[]
