generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  type                   TenantType              @default(HOTEL_GROUP)
  status                 TenantStatus            @default(ACTIVE)
  taxId                  String?                 @unique
  logoUrl                String?
  primaryColor           String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  kycLevel               Int                     @default(0)
  kycStatus              String                  @default("NOT_STARTED")
  kycVerifiedAt          DateTime?
  parentTenantId         String?
  relation               TenantRelation          @default(STANDALONE)
  verificationStatus     VerificationStatus      @default(UNVERIFIED)
  verifiedAt             DateTime?
  verifiedBy             String?
  legalName              String?
  billingContactName     String?
  billingContactEmail    String?
  billingContactPhone    String?
  uuid                   String?                 @unique(map: "Tenant_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt              DateTime?
  aiSubscriptions        AISubscription[]
  agentRuns              AgentRun[]
  auditLogs              AuditLog[]
  carts                  Cart[]
  competitors            Competitor[]
  consentRecords         ConsentRecord[]
  consolidatedInvoices   ConsolidatedInvoice[]
  consolidatedOrders     ConsolidatedOrder[]
  creditFacilities       CreditFacility[]
  creditLineApplications CreditLineApplication[]
  creditTransactions     CreditTransaction[]
  deliveryZones          DeliveryZone[]
  disputes               Dispute[]
  documents              Document[]
  documentProcessings    DocumentProcessing[]
  etaCredential          EtaCredential?
  etaDeadLetterJobs      EtaDeadLetterJob[]
  factoringCompanies     FactoringCompany[]
  factoringRequests      FactoringRequest[]
  factoringTransactions  FactoringTransaction[]
  featureProposals       FeatureProposal[]
  forecastAccuracies     ForecastAccuracy[]
  hotels                 Hotel[]
  hotelSuppliers         HotelSupplier[]
  inventorySnapshots     InventorySnapshot[]
  invoPartners           InvoPartner[]
  invoSubscriptions      InvoSubscription[]
  invoices               Invoice[]
  journalEntries         JournalEntry[]
  leads                  Lead[]
  ledgerEntries          LedgerEntry[]
  logisticsHubs          LogisticsHub[]
  marketInsights         MarketInsight[]
  olivCreditFacilities   OlivCreditFacility[]
  olivOnboardingAudits   OlivOnboardingAudit[]
  olivSyncLogs           OlivSyncLog[]
  orders                 Order[]
  outlets                Outlet[]
  payments               Payment[]
  PaymentTerm            PaymentTerm[]
  paymentTransactions    PaymentTransaction[]
  products               Product[]
  productSeasonalities   ProductSeasonality[]
  promoCodes             PromoCode[]
  properties             Property[]
  refreshTokens          RefreshToken[]
  roles                  Role[]
  spendRecords           SpendRecord[]
  suppliers              Supplier[]
  supplierAudits         SupplierAudit[]
  swarmJobs              SwarmJob[]
  swarmMemories          SwarmMemory[]
  Tenant                 Tenant?                 @relation("TenantToTenant", fields: [parentTenantId], references: [id], onUpdate: NoAction, map: "Tenant_parent_fkey")
  other_Tenant           Tenant[]                @relation("TenantToTenant")
  trips                  Trip[]
  tripStops              TripStop[]
  users                  User[]
  Workspace              Workspace[]
  goodsReceiptNotes      GoodsReceiptNote[]
  carrierProfiles        CarrierProfile[]
  consumptionForecasts   ConsumptionForecast[]
  inventoryReconciliations InventoryReconciliation[]
  onboardingProgresses   OnboardingProgress[]
  pushTokens             PushToken[]
  scheduledOrders        ScheduledOrder[]
  supportTickets         SupportTicket[]

  @@index([deletedAt], map: "Tenant_deleted_idx")
  @@index([parentTenantId], map: "Tenant_parent_idx")
  @@index([uuid])
  @@index([verificationStatus], map: "Tenant_verification_idx")
}

model Role {
  id              String           @id @default(cuid())
  name            String
  tenantId        String?
  isGlobal        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  uuid            String?          @unique(map: "Role_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt       DateTime?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  users           User[]
  permissions     Permission[]     @relation("PermissionToRole")

  @@unique([tenantId, name])
  @@index([deletedAt], map: "Role_deleted_idx")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  uuid            String?          @unique(map: "Permission_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt       DateTime?
  rolePermissions RolePermission[]
  roles           Role[]           @relation("PermissionToRole")

  @@index([deletedAt], map: "Permission_deleted_idx")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  uuid         String?    @unique(map: "RolePermission_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt    DateTime?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([deletedAt], map: "RolePermission_deleted_idx")
}

model Hotel {
  id                   String                @id @default(cuid())
  tenantId             String
  name                 String
  legalName            String?
  taxId                String                @unique
  commercialReg        String?
  address              String?
  city                 String
  governorate          String
  phone                String?
  email                String?
  starRating           Int?
  roomCount            Int?
  tier                 HotelTier             @default(CORE)
  status               HotelStatus           @default(ACTIVE)
  riskScore            Int?                  @default(50)
  riskTier             RiskTier?             @default(MEDIUM)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  uuid                 String?               @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt            DateTime?
  creditLimit          Decimal?              @db.Decimal(14, 2)
  creditUsed           Decimal?              @db.Decimal(14, 2)
  carts                Cart[]
  consolidatedInvoices ConsolidatedInvoice[]
  creditFacilities     CreditFacility[]
  creditTransactions   CreditTransaction[]
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mandatedSuppliers    HotelSupplier[]
  invoices             Invoice[]
  journalEntries       JournalEntry[]
  orders               Order[]
  payments             Payment[]
  properties           Property[]
  spendRecords         SpendRecord[]
  tripStops            TripStop[]
  users                User[]
  goodsReceiptNotes    GoodsReceiptNote[]
  consumptionForecasts ConsumptionForecast[]
  inventoryReconciliations InventoryReconciliation[]
  scheduledOrders      ScheduledOrder[]

  @@index([tenantId])
  @@index([city])
  @@index([status])
  @@index([deletedAt], map: "Hotel_deleted_idx")
}

model Property {
  id          String       @id @default(cuid())
  name        String
  address     String
  city        String
  governorate String
  roomCount   Int?
  type        PropertyType @default(HOTEL)
  hotelId     String
  tenantId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  uuid        String?      @unique(map: "Property_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt   DateTime?
  orders      Order[]
  outlets     Outlet[]
  hotel       Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([deletedAt], map: "Property_deleted_idx")
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  name                   String
  companyName            String?
  phone                  String?                  @unique
  role                   UserRole                 @default(DEPARTMENT_HEAD)
  status                 UserStatus               @default(ACTIVE)
  sector                 UserSector?
  passwordHash           String?
  refreshTokenHash       String?
  platformRole           PlatformRole             @default(HOTEL)
  tenantId               String
  roleId                 String
  hotelId                String?
  supplierId             String?
  factoringCompanyId     String?
  canOverride            Boolean                  @default(false)
  inviteToken            String?                  @unique
  inviteExpiresAt        DateTime?
  invitedBy              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  lastActive             DateTime?
  accountType            AccountType              @default(BUSINESS)
  emailVerifiedAt        DateTime?
  marketingConsent       Boolean                  @default(false)
  termsAcceptedAt        DateTime?
  privacyPolicyVersion   String?
  kycLevel               Int                      @default(0)
  kycStatus              String                   @default("NOT_STARTED")
  kycVerifiedAt          DateTime?
  uuid                   String?                  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  totpSecret             String?
  twoFactorEnabled       Boolean                  @default(false)
  ownedTenantId          String?
  transferToken          String?                  @unique(map: "User_transfer_token_uniq")
  transferExpiresAt      DateTime?
  phoneVerifiedAt        DateTime?
  deletedAt              DateTime?
  aiUsage                AiUsage?
  carts                  Cart?
  consentRecords         ConsentRecord[]
  conversations          Conversation[]
  Notification           Notification[]
  NotificationPreference NotificationPreference[]
  orders                 Order[]
  approvals              OrderApproval[]
  reviews                ProductReview[]
  refreshTokens          RefreshToken[]
  sampleRequests         SampleRequest[]
  factoringCompany       FactoringCompany?        @relation(fields: [factoringCompanyId], references: [id])
  hotel                  Hotel?                   @relation(fields: [hotelId], references: [id])
  assignedRole           Role                     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  supplier               Supplier?                @relation(fields: [supplierId], references: [id])
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses              UserAddress[]
  pairingCodes           PairingCode[]
  carrierProfile         CarrierProfile?
  onboardingProgress     OnboardingProgress?
  pushTokens             PushToken[]
  supportTickets         SupportTicket[]

  @@index([sector])
  @@index([tenantId])
  @@index([hotelId])
  @@index([supplierId])
  @@index([roleId])
  @@index([status])
  @@index([platformRole])
  @@index([deletedAt], map: "User_deleted_idx")
  @@index([uuid])
}

model OtpVerification {
  id         String    @id @default(cuid())
  phone      String
  purpose    String
  provider   String
  codeHash   String?
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  uuid       String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@unique([phone])
  @@index([phone, purpose, createdAt])
  @@index([deletedAt])
}

model PairingCode {
  id            String    @id @default(cuid())
  code          String    @unique
  userId        String
  tenantId      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  linkedUserId  String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model Supplier {
  id                   String               @id @default(cuid())
  name                 String
  legalName            String?
  taxId                String               @unique
  commercialReg        String?
  address              String?
  city                 String
  governorate          String
  phone                String?
  email                String               @unique
  website              String?
  description          String?
  logoUrl              String?
  status               SupplierStatus       @default(PENDING)
  tier                 SupplierTier         @default(CORE)
  type                 SupplierType         @default(WHOLESALER)
  isVerified           Boolean              @default(false)
  returnPolicyDays     Int                  @default(14)
  rating               Float?               @default(0)
  reviewCount          Int                  @default(0)
  certifications       String?
  bankAccount          String?
  bankName             String?
  tenantId             String
  olivUserId           String?
  olivFacilityId       String?
  olivSyncAt           DateTime?
  olivStatus           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  uuid                 String?              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt            DateTime?
  deliveryZones        DeliveryZone[]
  documentProcessings  DocumentProcessing[]
  hotelMandates        HotelSupplier[]
  invoSubscription     InvoSubscription?
  invoices             Invoice[]
  olivCreditFacilities OlivCreditFacility[]
  orders               Order[]
  products             Product[]
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audits               SupplierAudit[]
  users                User[]
  goodsReceiptNotes    GoodsReceiptNote[]
  scheduledOrders      ScheduledOrder[]

  @@index([tenantId])
  @@index([city])
  @@index([status])
  @@index([tier])
  @@index([deletedAt], map: "Supplier_deleted_idx")
}

model DeliveryZone {
  id         String    @id @default(cuid())
  zone       String
  minDays    Int
  maxDays    Int
  supplierId String
  tenantId   String
  createdAt  DateTime  @default(now())
  uuid       String?   @unique(map: "DeliveryZone_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt  DateTime?
  fee        Decimal?  @db.Decimal(12, 2)
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([deletedAt], map: "DeliveryZone_deleted_idx")
}

model Product {
  id                 String               @id @default(cuid())
  sku                String               @unique
  name               String
  description        String?
  category           ProductCategory
  subcategory        String?
  currency           String               @default("EGP")
  volumeTiers        String?
  stockQuantity      Int                  @default(0)
  minOrderQty        Int                  @default(1)
  leadTimeDays       Int                  @default(1)
  reorderPoint       Int                  @default(10)
  reorderQty         Int                  @default(50)
  avgDailyUsage      Float                @default(0)
  lastCountedAt      DateTime?
  aiForecast         String?
  unitOfMeasure      String               @default("piece")
  shelfLifeDays      Int?
  temperatureReq     String?
  images             String?
  specs              String?
  status             ProductStatus        @default(ACTIVE)
  supplierId         String
  tenantId           String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  uuid               String?              @unique(map: "Product_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt          DateTime?
  unitPrice          Decimal?             @db.Decimal(12, 2)
  basePrice          Decimal?             @db.Decimal(12, 2)
  pricingMode        PricingMode          @default(FIXED)
  rfqThresholdQty    Int?
  source             ProductSource        @default(FIXTURE)
  sourceProvider     String?
  sourceKey          String?
  cartItems          CartItem[]
  inventorySnapshots InventorySnapshot[]
  orderItems         OrderItem[]
  supplier           Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews            ProductReview[]
  seasonalities      ProductSeasonality[]
  ProductTierPrice   ProductTierPrice[]
  grnLineItems       GrnLineItem[]
  consumptionForecasts ConsumptionForecast[]
  productVariations  ProductVariation[]
  reconciliationLineItems ReconciliationLineItem[] @relation("ProductReconciliationLineItems")
  scheduledOrderItems ScheduledOrderItem[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt], map: "Product_deleted_idx")
}

model ProductSeasonality {
  id         String    @id @default(cuid())
  productId  String
  month      Int
  multiplier Float     @default(1.0)
  tenantId   String
  createdAt  DateTime  @default(now())
  uuid       String?   @unique(map: "ProductSeasonality_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt  DateTime?
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, month, tenantId])
  @@index([tenantId])
  @@index([productId])
  @@index([deletedAt], map: "ProductSeasonality_deleted_idx")
}

model Order {
  id                     String              @id @default(cuid())
  orderNumber            String              @unique
  status                 OrderStatus         @default(DRAFT)
  currency               String              @default("EGP")
  deliveryDate           DateTime?
  deliveryInstructions   String?
  hotelId                String
  propertyId             String?
  outletId               String?
  supplierId             String
  requesterId            String
  tenantId               String
  etaSubmissionId        String?             @unique
  paymentGuaranteed      Boolean             @default(false)
  paymentGuaranteeMethod String?
  paymentGuaranteeSetAt  DateTime?
  checkoutGroupId        String?
  shippingMethod         String?
  estimatedDelivery      DateTime?
  poNumber               String?
  costCenter             String?
  deliveryAddress        String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  uuid                   String?             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt              DateTime?
  subtotal               Decimal?            @db.Decimal(12, 2)
  vatAmount              Decimal?            @db.Decimal(12, 2)
  total                  Decimal?            @db.Decimal(12, 2)
  shippingCost           Decimal?            @db.Decimal(12, 2)
  scheduledOrderId       String?
  creditTransactions     CreditTransaction[]
  disputes               Dispute[]
  invoices               Invoice[]
  hotel                  Hotel               @relation(fields: [hotelId], references: [id])
  outlet                 Outlet?             @relation(fields: [outletId], references: [id])
  property               Property?           @relation(fields: [propertyId], references: [id])
  requester              User                @relation(fields: [requesterId], references: [id])
  supplier               Supplier            @relation(fields: [supplierId], references: [id])
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvals              OrderApproval[]
  items                  OrderItem[]
  ReturnRequest          ReturnRequest[]
  tripStops              TripStop[]
  goodsReceiptNotes      GoodsReceiptNote[]
  scheduledOrder         ScheduledOrder?       @relation(fields: [scheduledOrderId], references: [id])

  @@index([tenantId])
  @@index([hotelId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt], map: "Order_deleted_idx")
}

model OrderItem {
  id               String    @id @default(cuid())
  quantity         Int
  receivedQuantity Int?
  returnedQuantity Int?      @default(0)
  returnReason     String?
  orderId          String
  productId        String
  notes            String?
  uuid             String?   @unique(map: "OrderItem_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt        DateTime?
  unitPrice        Decimal?  @db.Decimal(12, 2)
  total            Decimal?  @db.Decimal(12, 2)
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id])
  grnLineItems     GrnLineItem[]

  @@index([deletedAt], map: "OrderItem_deleted_idx")
}

model OrderApproval {
  id          String         @id @default(cuid())
  orderId     String
  approverId  String
  action      ApprovalAction
  reason      String?
  beforeState String?
  afterState  String?
  createdAt   DateTime       @default(now())
  uuid        String?        @unique(map: "OrderApproval_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt   DateTime?
  approver    User           @relation(fields: [approverId], references: [id])
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, approverId])
  @@index([deletedAt], map: "OrderApproval_deleted_idx")
}

model Invoice {
  id                    String               @id @default(cuid())
  invoiceNumber         String               @unique
  etaUuid               String?              @unique
  etaStatus             EtaStatus            @default(PENDING)
  digitalSignature      String?
  submissionLog         String?
  codeName              String?
  codeNameAr            String?
  description           String?
  descriptionAr         String?
  currency              String               @default("EGP")
  retentionReleaseDate  DateTime?
  issueDate             DateTime
  dueDate               DateTime?
  paidDate              DateTime?
  status                InvoiceStatus        @default(DRAFT)
  paymentStatus         PaymentStatus        @default(UNPAID)
  orderId               String
  hotelId               String
  supplierId            String
  tenantId              String
  consolidatedInvoiceId String?
  factoringStatus       FactoringStatus      @default(NOT_FACTORABLE)
  factoringCompanyId    String?
  acceleratedCashRate   Decimal              @default(0)
  supplierDiscountRate  Decimal              @default(0)
  cashDiscountDelta     Decimal              @default(0)
  platformFee           Decimal              @default(0)
  platformFeeRate       Decimal              @default(0)
  hotelAdminFeeRate     Decimal              @default(0)
  hotelAdminFeeAmount   Decimal              @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  uuid                  String?              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt             DateTime?
  subtotal              Decimal?             @db.Decimal(12, 2)
  vatRate               Decimal?             @db.Decimal(5, 4)
  vatAmount             Decimal?             @db.Decimal(12, 2)
  total                 Decimal?             @db.Decimal(12, 2)
  returnedAmount        Decimal?             @db.Decimal(12, 2)
  retentionRate         Decimal?             @db.Decimal(5, 4)
  retentionAmount       Decimal?             @db.Decimal(12, 2)
  netPayable            Decimal?             @db.Decimal(12, 2)
  creditTransactions    CreditTransaction[]
  documentProcessing    DocumentProcessing?
  etaDeadLetterJobs     EtaDeadLetterJob[]
  factoringRequests     FactoringRequest?
  consolidatedInvoice   ConsolidatedInvoice? @relation(fields: [consolidatedInvoiceId], references: [id])
  factoringCompany      FactoringCompany?    @relation(fields: [factoringCompanyId], references: [id])
  hotel                 Hotel                @relation(fields: [hotelId], references: [id])
  order                 Order                @relation(fields: [orderId], references: [id])
  supplier              Supplier             @relation(fields: [supplierId], references: [id])
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments              Payment[]

  @@index([tenantId])
  @@index([hotelId])
  @@index([supplierId])
  @@index([orderId])
  @@index([status])
  @@index([factoringStatus])
  @@index([createdAt])
  @@index([deletedAt], map: "Invoice_deleted_idx")
}

model EtaCredential {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  clientId     String
  clientSecret String
  taxId        String
  environment  String    @default("preprod")
  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  uuid         String?   @unique(map: "EtaCredential_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt    DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([deletedAt], map: "EtaCredential_deleted_idx")
}

model EtaDeadLetterJob {
  id            String              @id @default(cuid())
  invoiceId     String
  invoiceNumber String
  error         String
  attemptCount  Int                 @default(0)
  maxAttempts   Int                 @default(4)
  nextRetryAt   DateTime
  status        EtaDeadLetterStatus @default(PENDING)
  tenantId      String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  uuid          String?             @unique(map: "EtaDeadLetterJob_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt     DateTime?
  invoice       Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([invoiceId])
  @@index([status, nextRetryAt])
  @@index([deletedAt], map: "EtaDeadLetterJob_deleted_idx")
}

model AuthorityRule {
  id                       String          @id @default(cuid())
  role                     UserRole
  category                 String?
  supplierTier             String?
  hotelRiskTier            HotelRiskTier?
  hotelTier                HotelTier?
  requesterRole            UserRole?
  requiresPaymentGuarantee Boolean         @default(false)
  requiresEtaValidation    Boolean         @default(false)
  requiresDualSignOff      Boolean         @default(false)
  action                   AuthorityAction
  routeToRole              UserRole?
  hotelId                  String?
  tenantId                 String?
  name                     String?
  description              String?
  priority                 Int             @default(0)
  isActive                 Boolean         @default(true)
