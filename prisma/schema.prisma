  startDate         DateTime?
  endDate           DateTime?
  targetAudience    String?
  status            String   @default("draft")
  content           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

model ContentSchedule {
  id          String   @id @default(cuid())
  title       String
  type        String
  scheduledAt DateTime
  url         String?
  status      String   @default("scheduled")
  tenantId    String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([scheduledAt])
  @@index([type])
}

model SocialAccount {
  id           String   @id @default(cuid())
  platform     String
  pageId       String
  pageName     String
  accessToken  String
  connectedAt  DateTime @default(now())
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([platform])
}

model InvoPartner {
  id            String   @id @default(cuid())
  partnerId     String   @unique
  tenantId      String
  name          String
  type          String   @default("unknown")
  taxId         String?
  email         String?
  phone         String?
  contactName   String?
  address       String?
  categories    String[]
  documents     String[]
  status        String   @default("pending_review")
  submittedAt   DateTime @default(now())
  reviewedAt    DateTime?
  reviewerNotes String?
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([name])
  @@index([type])
}

model SupportTicket {
  id            String                @id @default(cuid())
  tenantId      String
  userId        String
  userName      String
  userEmail     String
  subject       String
  description   String
  category      SupportTicketCategory
  priority      SupportTicketPriority
  status        SupportTicketStatus   @default(OPEN)
  agentResponse String?
  adminNotes    String?
  resolution    String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  resolvedAt    DateTime?
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([createdAt])
  @@index([priority])
  @@index([status])
  @@index([tenantId])
  @@index([userId])
}

model ScheduledOrder {
  id                 String               @id @default(cuid())
  tenantId           String
  hotelId            String
  propertyId         String?
  outletId           String?
  supplierId         String
  frequency          ScheduleFrequency
  cronExpression     String?
  nextRunAt          DateTime
  lastRunAt          DateTime?
  status             ScheduleStatus       @default(ACTIVE)
  name               String
  notes              String?
  autoSubmit         Boolean              @default(false)
  maxOrderValue      Decimal?             @db.Decimal(14, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  uuid               String?              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt          DateTime?
  orders             Order[]
  hotel              Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  supplier           Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items              ScheduledOrderItem[]

  @@index([hotelId])
  @@index([nextRunAt])
  @@index([status])
  @@index([supplierId])
  @@index([tenantId])
}

model ScheduledOrderItem {
  id               String         @id @default(cuid())
  scheduledOrderId String
  productId        String
  quantity         Int
  unitPrice        Decimal?       @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  scheduledOrder   ScheduledOrder @relation(fields: [scheduledOrderId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([scheduledOrderId])
}

model PushToken {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String
  token     String    @unique
  platform  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  uuid      String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([deletedAt])
  @@index([userId])
}

model InventoryReconciliation {
  id          String                   @id @default(cuid())
  tenantId    String
  hotelId     String
  propertyId  String?
  period      String
  periodStart DateTime
  periodEnd   DateTime
  status      ReconciliationStatus     @default(DRAFT)
  notes       String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  uuid        String?                  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt   DateTime?
  hotel       Hotel                    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItems   ReconciliationLineItem[] @relation("InventoryReconciliationLineItems")

  @@index([hotelId])
  @@index([period])
  @@index([status])
  @@index([tenantId])
}

model ReconciliationLineItem {
  id                      String                  @id @default(cuid())
  reconciliationId        String
  productId               String
  beginningQuantity       Int
  endingQuantity          Int
  receivedQuantity        Int                     @default(0)
  consumedQuantity        Int                     @default(0)
  wasteQuantity           Int                     @default(0)
  varianceQuantity        Int                     @default(0)
  varianceReason          String?
  unitCost                Decimal?                @db.Decimal(12, 2)
  totalValue              Decimal?                @db.Decimal(14, 2)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  product                 Product                 @relation("ProductReconciliationLineItems", fields: [productId], references: [id], onDelete: Cascade)
  inventoryReconciliation InventoryReconciliation @relation("InventoryReconciliationLineItems", fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([reconciliationId])
}

model RfqRequest {
  id                String    @id @default(cuid())
  buyerId           String
  productId         String
  supplierId        String
  requestedQty      Int
  targetPrice       Decimal?  @db.Decimal(12, 2)
  deliveryTimeline  String?
  specialReq        String?
