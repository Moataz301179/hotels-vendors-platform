/// PDPL-compliant consent record for data sharing with Oliv Finance.
/// Every data share event must have a corresponding consent record.
model ConsentRecord {
  id               String        @id @default(cuid())
  userId           String
  tenantId         String
  /// What consent was given: "OLIV_DATA_SHARING", "OLIV_CREDIT_ASSESSMENT", etc.
  consentType      String
  /// Which partner data is shared with: "oliv_finance"
  partnerId        String
  /// Version of the consent text the user agreed to
  consentVersion   String
  /// What data categories were consented: ["business_registration", "eta_invoices", "bank_details"]
  dataCategories   String
  /// IP address at time of consent
  ipAddress        String?
  /// User agent at time of consent
  userAgent        String?
  /// Consent status: GRANTED, WITHDRAWN, EXPIRED
  status           ConsentStatus @default(GRANTED)
  /// When consent was withdrawn (if applicable)
  withdrawnAt      DateTime?
  /// Reason for withdrawal (if provided)
  withdrawalReason String?
  /// Audit hash for tamper-proofing
  hash             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  uuid             String?       @unique(map: "ConsentRecord_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt        DateTime?
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType, partnerId])
  @@index([userId, status])
  @@index([partnerId, status])
  @@index([tenantId])
  @@index([deletedAt], map: "ConsentRecord_deleted_idx")
}

/// Oliv credit facility — synced from Oliv via webhooks.
/// HotelsVendors stores the credit line limit, balance, and payment schedule
/// so the supplier can see everything on their dashboard without leaving the platform.
model OlivCreditFacility {
  id              String             @id @default(cuid())
  /// Supplier who owns this credit facility
  supplierId      String
  tenantId        String
  /// Oliv's internal credit facility ID
  olivFacilityId  String             @unique
  /// Settlement terms in days
  settlementDays  Int                @default(90)
  /// Facility status
  status          OlivFacilityStatus @default(ACTIVE)
  /// When Oliv approved the facility
  approvedAt      DateTime?
  /// When the facility expires
  expiresAt       DateTime?
  /// Last sync timestamp from Oliv
  lastSyncedAt    DateTime?
  /// Oliv's risk assessment for this supplier
  olivRiskScore   Int?
  olivRiskTier    String?
  /// Payment schedule as JSON string: [{ dueDate, amountEgp, status }]
  paymentSchedule String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  uuid            String?            @unique(map: "OlivCreditFacility_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt       DateTime?
  /// Credit limit in EGP
  creditLimitEgp  Decimal?           @db.Decimal(14, 2)
  /// Currently utilized amount in EGP
  utilizedEgp     Decimal?           @db.Decimal(14, 2)
  /// Available balance in EGP (creditLimit - utilized)
  availableEgp    Decimal?           @db.Decimal(14, 2)
  /// Interest rate (as decimal, e.g., 0.025 = 2.5%)
  interestRate    Decimal?           @db.Decimal(5, 4)
  /// Advance rate (as decimal, e.g., 0.88 = 88% of invoice value)
  advanceRate     Decimal?           @db.Decimal(5, 4)
  /// Discount rate (as decimal, e.g., 0.025 = 2.5% partner fee)
  discountRate    Decimal?           @db.Decimal(5, 4)
  supplier        Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([supplierId, status])
  @@index([tenantId])
  @@index([deletedAt], map: "OlivCreditFacility_deleted_idx")
}

/// Oliv sync log — tracks every data exchange between HotelsVendors and Oliv.
model OlivSyncLog {
  id             String        @id @default(cuid())
  /// Direction: INBOUND (Oliv → HotelsVendors) or OUTBOUND (HotelsVendors → Oliv)
  direction      SyncDirection
  /// Event type: "REGISTRATION_PRE_FILL", "CREDIT_STATUS_UPDATE", "DISBURSEMENT", etc.
  eventType      String
  /// Entity type: "Supplier", "OlivCreditFacility", "FactoringRequest"
  entityType     String
  entityId       String
  /// Payload sent or received (encrypted at rest)
  payload        String?
  /// Oliv's response or error
  response       String?
  /// HTTP status code (if applicable)
  httpStatus     Int?
  /// Whether the sync was successful
  success        Boolean       @default(true)
  /// Error message (if failed)
  error          String?
  /// Idempotency key for deduplication
  idempotencyKey String?       @unique
  tenantId       String
  createdAt      DateTime      @default(now())
  uuid           String?       @unique(map: "OlivSyncLog_uuid_uniq") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt      DateTime?
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([direction, eventType])
  @@index([entityType, entityId])
  @@index([tenantId])
  @@index([success])
  @@index([deletedAt], map: "OlivSyncLog_deleted_idx")
}

