{
  "expo": {
    "name": "HOVIN",
    "slug": "hovin-mobile",
    "scheme": "hovin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#303234",
    "primaryColor": "#5B92FE",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "HOVIN uses the camera to photograph a goods receipt while a hotel receiver records what arrived. The server removes photo metadata before the file is stored.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/with-xcode27-fmt-fix",
      "./plugins/with-ios-script-sandboxing",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hotelsvendors.hovin",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "HOVIN uses the camera to photograph a goods receipt while a hotel receiver records what arrived. The server removes photo metadata before the file is stored.",
        "CFBundleDisplayName": "HOVIN"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hotelsvendors.hovin",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2b2d2f"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bd9d5d11-8eb4-4353-a7be-556cccd131f1"
      }
    },
    "owner": "hotelsvendors"
  }
}
