{
  "expo": {
    "name": "HOVIN",
    "slug": "hovin-mobile",
    "scheme": "hovin",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f1f0e8",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "HOVIN uses the camera to photograph a goods receipt while a hotel receiver records what arrived. The server removes photo metadata before the file is stored.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/with-xcode27-fmt-fix",
      "./plugins/with-ios-script-sandboxing",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.hotelsvendors.hovin"
    },
    "android": {
      "package": "com.hotelsvendors.hovin"
    }
  }
}
