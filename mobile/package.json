{
  "name": "hovin-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/with-hv-public-env.mjs expo start",
    "typecheck": "tsc --noEmit",
    "android": "node scripts/with-hv-public-env.mjs expo run:android",
    "ios": "node scripts/with-hv-public-env.mjs expo run:ios",
    "doctor:ios": "node scripts/ios-sim-doctor.mjs",
    "export:ios": "node scripts/with-hv-public-env.mjs expo export --platform ios --output-dir dist/ios",
    "release:check": "node scripts/release-readiness.mjs",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:submit:ios": "eas submit --platform ios --profile production",
    "eas:submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@clerk/expo": "^4.15.1",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "expo": "~58.0.25",
    "expo-auth-session": "~58.0.18",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
