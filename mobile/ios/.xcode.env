# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create a `.xcode.env.local`
# file that is not versioned (recommended on Mac: pin an absolute Node path).

# NODE_BINARY must resolve when Xcode GUI builds. GUI launches strip most of
# PATH, so `command -v node` alone often returns empty and late script phases
# hang near the end of the build (e.g. 450+/455) with no useful error.
#
# Prefer `.xcode.env.local` with an absolute path, for example:
#   export NODE_BINARY=/opt/homebrew/bin/node
#   export NODE_BINARY="$HOME/.nvm/versions/node/v20.19.0/bin/node"

resolve_node() {
  if [[ -n "${NODE_BINARY:-}" && -x "$NODE_BINARY" ]]; then
    printf '%s\n' "$NODE_BINARY"
    return 0
  fi

  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi

  local candidate
  for candidate in \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    "$HOME/.local/share/fnm/current/bin/node" \
    "$HOME/.fnm/current/bin/node" \
    "$HOME/.volta/bin/node" \
    "$HOME/.asdf/shims/node"
  do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
    # shellcheck disable=SC1090
    . "$HOME/.nvm/nvm.sh" --no-use >/dev/null 2>&1 || true
    if command -v node >/dev/null 2>&1; then
      command -v node
      return 0
    fi
  fi

  return 1
}

NODE_BINARY="$(resolve_node || true)"
export NODE_BINARY

if [[ -z "${NODE_BINARY}" || ! -x "${NODE_BINARY}" ]]; then
  echo "error: NODE_BINARY is unset or not executable." >&2
  echo "Create mobile/ios/.xcode.env.local with: export NODE_BINARY=\$(command -v node)" >&2
  echo "Or pin an absolute path, e.g. export NODE_BINARY=/opt/homebrew/bin/node" >&2
  # Do not exit here: older Xcode phases still surface the failure from react-native-xcode.sh.
fi
