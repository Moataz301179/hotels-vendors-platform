<script>
document.addEventListener('DOMContentLoaded', function() {
  const trigger = document.getElementById('sidebarTrigger');
  const sidebar = document.getElementById('amazonSidebarMenu');
  const overlay = document.getElementById('sidebarOverlay');
  const closeButton = document.getElementById('closeSidebar');
  const categoryButtons = document.querySelectorAll('.category-item.has-submenu .category-link');
  const backButtons = document.querySelectorAll('.back-button');

  function openSidebar() {
    sidebar.classList.add('active');
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebar.classList.remove('active');
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    // Reset all submenus
    document.querySelectorAll('.submenu.active').forEach(submenu => {
      submenu.classList.remove('active');
    });
  }

  // Event Listeners
  if (trigger) {
    trigger.addEventListener('click', function(e) {
      e.preventDefault();
      openSidebar();
    });
  }

  if (closeButton) {
    closeButton.addEventListener('click', function(e) {
      e.preventDefault();
      closeSidebar();
    });
  }

  if (overlay) {
    overlay.addEventListener('click', function(e) {
      e.preventDefault();
      closeSidebar();
    });
  }

  // Handle submenu navigation
  categoryButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const submenu = this.nextElementSibling;
      if (submenu) {
        submenu.classList.add('active');
      }
    });
  });

  // Handle back button in submenus
  backButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const submenu = this.closest('.submenu');
      if (submenu) {
        submenu.classList.remove('active');
      }
    });
  });

  // Close on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && sidebar.classList.contains('active')) {
      closeSidebar();
    }
  });
});

  // mobile responsibe

document.addEventListener('DOMContentLoaded', function() {
  // Mobile Header Logic
  const mobileBreakpoint = 749;
  const header = document.querySelector('.site-header');
  const searchBar = document.querySelector('.search-bar__interior');
  const mobileMenu = document.querySelector('.mobile-nav-wrapper');
  const mobileMenuTrigger = document.querySelector('.js-mobile-nav-toggle');

  // Function to handle mobile search expansion
  function handleMobileSearch() {
    if (window.innerWidth <= mobileBreakpoint) {
      searchBar.classList.add('mobile-search');
      //searchBar.style.width = '100%';
    } else {
      searchBar.classList.remove('mobile-search');
      searchBar.style.width = '';
    }
  }

  // Function to handle header height adjustments
  function updateHeaderHeight() {
    const headerHeight = header.offsetHeight;
    document.documentElement.style.setProperty('--header-height', `${headerHeight}px`);
  }

  // Mobile menu toggle
  if (mobileMenuTrigger) {
    mobileMenuTrigger.addEventListener('click', function(e) {
      e.preventDefault();
      const isExpanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', !isExpanded);
      mobileMenu.classList.toggle('is-active');
      document.body.classList.toggle('mobile-menu-open');
    });
  }

  // Close mobile menu when clicking outside
  document.addEventListener('click', function(e) {
    if (mobileMenu && mobileMenu.classList.contains('is-active')) {
      if (!mobileMenu.contains(e.target) && !mobileMenuTrigger.contains(e.target)) {
        mobileMenu.classList.remove('is-active');
        mobileMenuTrigger.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('mobile-menu-open');
      }
    }
  });

  // Handle window resize events
  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      handleMobileSearch();
      updateHeaderHeight();
    }, 250);
  });

  // Initialize mobile-specific behaviors
  handleMobileSearch();
  updateHeaderHeight();

  // Fix for iOS Safari 100vh issue
  function fixMobileVH() {
    const vh = window.innerHeight * 0.01;
    document.documentElement.style.setProperty('--vh', `${vh}px`);
  }

  window.addEventListener('resize', fixMobileVH);
  window.addEventListener('orientationchange', fixMobileVH);
  fixMobileVH();

  // Improve touch interactions
  if ('ontouchstart' in window) {
    document.body.classList.add('has-touch');
  }
});
window.onload = function() {
  const categoryOptions = document.querySelectorAll('.category-option');
  const categoryInput = document.getElementById('selected_category');
  
  if (categoryInput) {
    categoryOptions.forEach(function(option) {
      option.addEventListener('click', function() {
        const selectedCategory = option.getAttribute('data-value');
        categoryInput.value = selectedCategory;
      });
    });
  }

  const searchInput = document.getElementById('predictive-search-drawer-input');
  if (searchInput) {
    searchInput.addEventListener('keypress', function(event) {
      if (event.key === 'Enter') {
        event.preventDefault();
        const searchForm = document.querySelector('.search-form');
        if (searchForm) {
          searchForm.submit();
        }
      }
    });
  }
};
</script> 


<script>
document.addEventListener('DOMContentLoaded', function() {
  const scrollHeader = document.getElementById('scrollHeader');
  let lastScrollY = 0;
  
  // Check if we're on mobile
  function isMobile() {
    return window.innerWidth < 750;
  }

  function handleScroll() {
    // Don't do anything if we're on mobile
    if (isMobile()) {
      scrollHeader.classList.remove('visible');
      return;
    }

    const scrollY = window.scrollY;
    
    // Show scroll header after scrolling down 200px
    if (scrollY > 200) {
      scrollHeader.classList.add('visible');
    } else {
      scrollHeader.classList.remove('visible');
    }

    lastScrollY = scrollY;
  }

  // Initial check
  handleScroll();

  // Add scroll listener
  window.addEventListener('scroll', handleScroll);
  
  // Also check on resize
  window.addEventListener('resize', handleScroll);
  
  // Search animation
  const searchContainer = scrollHeader.querySelector('.scroll-header__search');
  const searchInput = scrollHeader.querySelector('.scroll-header__search-input');
  
  if (searchContainer && searchInput) {
    // Focus effect
    searchInput.addEventListener('focus', function() {
      searchContainer.classList.add('expanded');
      
      // Slight adjustment to other elements for balance
      const logo = scrollHeader.querySelector('.scroll-header__logo');
      const actions = scrollHeader.querySelector('.scroll-header__search-input');
      
      if (logo) logo.style.opacity = '0.8';
      if (actions) actions.style.transform = 'translateY(0px)';
    });
    
    // Blur effect
    searchInput.addEventListener('blur', function() {
      searchContainer.classList.remove('expanded');
      
      // Restore other elements
      const logo = scrollHeader.querySelector('.scroll-header__logo');
      const actions = scrollHeader.querySelector('.scroll-header__search-input');
      
      if (logo) logo.style.opacity = '1';
      if (actions) actions.style.transform = 'translateX(0)';
    });
    
    // Click outside to close
    document.addEventListener('click', function(event) {
      if (!searchContainer.contains(event.target)) {
        searchContainer.classList.remove('expanded');
        
        // Restore other elements
        const logo = scrollHeader.querySelector('.scroll-header__logo');
        const actions = scrollHeader.querySelector('.scroll-header__search-input');
        
        if (logo) logo.style.opacity = '1';
        if (actions) actions.style.transform = 'translateX(0)';
      }
    });
  }
});
</script>
