  <style>
    .floating-menu {
      position: fixed;
      bottom: 10px;
      right: 10px!important;
      z-index: 99999;
    }
    .floating-menu .flt-ul-icon {
      margin: 0px;
      padding: 0px;
      list-style: none;
    }
    .floating-menu .flt-icon-url {
      text-decoration: none;
      color: #fff;
    }
    .floating-menu .flt-icon-text {
      display: none;
    }
    .floating-menu .flt-icon {
      font-size: 24px;
      height: 45px;
      width: 45px;
      line-height: 45px;
      margin-top: 5px;
      border-radius: 50%;
      display: inline-block;
      vertical-align: middle;
      text-align: center;
    }
    .floating-menu .flt-icon-wh {
      background: #06d755;
      color: #fff;
    }
    .floating-menu .flt-icon-en {
      background: #207BF6;
      color: #fff;
    }
    
    @media (max-width:991px) {
      .floating-menu {
        display: none;
      }
      #footer .foot_social {
        margin-bottom: 50px;
      }
      #footer .foot_links {
        margin-bottom: 20px;
      }
      #footer .foot_copyright .foot_copytext {
        padding-bottom: 60px;
      }
      #mobile-header .mob-mn-submenu-ul .dropdown-menu.show {
        max-height: 330px;
        overflow: auto;
        position: relative !important;
        transform: inherit !important;
      }
    }
    
    /* Mobile CTA Button */
    @media (min-width:991px) {
      .mobile-whatsapp {
        display: none;
      }
    }
    .mobile-whatsapp {
      border-top: 1px solid #fff;
      position: fixed !important;
      width: 100%;
      bottom: 0;
      z-index: 100;
    }
    .mobile-whatsapp .cta-nav {
      width:50%;
      float:left;
    }
    .mobile-whatsapp .cta-nav a {
      color:#fff;
      text-decoration:none;
    }
    .mobile-whatsapp .mob-callus {
      background: #207BF6;
    }
    .mobile-whatsapp .mob-whatsapp {
      background: #06d755;
    }
    .button-whatsapp {
      display: inline-flex;
      height: 40px;
      line-height: 1.2em;
      font-size: 14px;
      font-weight: 700;
      font-family: "Muli", sans-serif;
      text-transform: uppercase;
      color: #fff;
      border: none;
      border-radius: 20px;
      text-decoration: none;
      padding: 0 20px;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      letter-spacing: 1.5px;
      position: relative;
      text-align: center;
      transition-property: all!important;
      transition-duration: .5s!important;
      transition-delay: 0s!important;
      outline: none;
      background-color: #018fa3;
    }
    .mobile-whatsapp .button-whatsapp {
      margin: 0 auto;
      background: none;
      display: flex;
      height: 50px;
      font-size: 18px;
    }
  </style>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const breadcrumbLinks = document.querySelectorAll(".breadcrumb a");

  if (breadcrumbLinks.length === 2) {
    document.body.classList.add("remove-panel-before");
  }
});
</script>
<style> .site-footer a {color: #fff;} .collection-list-section .page-width {padding: 0px 82px 15px 92px;} .collection-list-section .collection-grid-item {box-shadow: unset; border: 0px;} .collection-grid-item__image-wrapper {width: 100%; padding: 15px;} .collection-list-section .section-header .section-header-content h2.mega-title--large {margin-bottom: 0px; text-align: center; font-size: 22px; font-weight: bold; text-transform: uppercase;} .primary-navigation nav.main-nav .nav-item:hover a {color: #d02031; background-color: #fff;} .site-footer__content .site-footer__social-icons .social-icons__item {background-color: inherit;} .site-footer__content .site-footer__social-icons .social-icons__item a.social-icons__link {color: inherit;} .collection-list-section .image_style_background .collection-grid-item .collection-grid-item__link:hover {box-shadow: 0 2px 4px 0 rgb(0 0 0 / 50%); border: 2px solid #c8102e;} @media screen and (max-width: 749px) {.bg_image_with_custom_content {min-height: 285px; } .collection-list-section .page-width {padding: 0px 34px 15px; margin-left: 0px; } .collection-list-section .section-header {margin-bottom: 20px; } .section-header .h5 {margin-left: 0px !important; }} </style>
