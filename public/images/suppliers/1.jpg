  background-color: #3a4553;
} */

/* Categories Trigger */
.amazon-style-categories {
  position: relative;
}

.categories-trigger {
  background: transparent;
  border: none;
  cursor: pointer;
  white-space: nowrap;
}

.categories-trigger svg {
  width: 18px;
  height: 18px;
}

/* Sidebar Styles */
.sidebar-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1001;
}

.sidebar-overlay.active {
  display: block;
}

.amazon-sidebar {
  position: fixed;
  top: 0;
  left: -100%;
  width: 365px;
  height: 100vh;
  background: #fff;
  z-index: 1002;
  transition: left 0.3s ease;
  display: flex;
  flex-direction: column;
  box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
}

.amazon-sidebar.active {
  left: 0;
}

.sidebar-header {
  background: #232f3e;
  color: #ffffff;
  padding: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.close-sidebar {
  background: transparent;
  border: none;
  color: #ffffff;
  cursor: pointer;
  padding: 8px;
}

.close-sidebar svg {
  width: 24px;
  height: 24px;
}

.sidebar-content {
  flex: 1;
  overflow-y: auto;
}

.main-categories {
  list-style: none;
  margin: 0;
  padding: 0;
}

.category-item {
  border-bottom: 1px solid #eee;
}

.category-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 12px 16px;
  color: #111;
  text-decoration: none;
  font-size: 14px;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
}

.category-link:hover {
  background-color: #f3f3f3;
}

/* Submenu Styles */
.submenu {
  position: absolute;
  top: 0;
  left: 100%;
  width: 100%;
  height: 100%;
  background: #fff;
  visibility: hidden;
  transition: transform 0.3s ease;
  overflow-y: auto;
}

.submenu.active {
  visibility: visible;
  transform: translateX(-100%);
}

.submenu-header {
  background: #232f3e;
  color: #ffffff;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.back-button {
  background: none;
  border: none;
  color: #ffffff;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 0;
}

.back-button svg {
  width: 16px;
  height: 16px;
}

.submenu-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.submenu-item a {
  display: block;
  padding: 12px 16px;
  color: #111;
  text-decoration: none;
  font-size: 14px;
  border-bottom: 1px solid #eee;
}

.submenu-item a:hover {
  background-color: #f3f3f3;
}

@media screen and (max-width: 749px) {
  .amazon-sidebar {
    width: 85%;
  }
  
  .nav-menu {
    display: none;
  }
  
  .primary-navigation {
    justify-content: space-between;
  }
}

/* .site-header .header_top__wrapper .site-header__icons .search-bar__interior {
  max-width: 800px; !important
} */

.customer_nav_button {
  margin: 0px 30px; !important
}

/* Mobile Responsive  */
/* Core Mobile Layout Fixes */
@media screen and (max-width: 749px) {
  /* Reset Grid Layout */
  .grid {
    display: block;
    margin: 0;
  }

  .grid__item {
    width: 100%;
    padding: 0;
    float: none;
  }

  /* Header Structure */
  .site-header {
    position: relative;
    padding: 0;
  }

  .header_top__wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* Logo Area */
  .logo_element-wrapper {
    text-align: center;
    padding: 10px;
    max-width: none !important;
    min-width: auto !important;
  }

  .logo_element img {
    max-height: 40px;
    width: auto;
  }

  /* Search Bar */
  .site-header__icons {
    width: 100%;
    padding: 10px;
  }

  .site-header__icons-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: space-between;
    align-items: center;
  }

  .search-bar__interior {
    display: flex;
    width: 100%;
    margin: 0 0 10px 0;
  }

  .search-form__input-wrapper {
    flex-grow: 1;
  }

  /* /* Icons and Cart */
  .header_cart_info {
    order: 2;
  } */

  .site-header__menu {
    order: 1;
  }

 .customer_nav_menu__wrapper {
    display: none
}

  /* Navigation */
  .header-nav-wrapper {
    width: 100%;
    padding: 0;
  }

  .primary-navigation {
    padding: 0;
  }

  .nav-menu {
    flex-direction: column;
    width: 100%;
    display: none;
  }

  /* Categories Menu */
  .amazon-style-categories {
    width: 100%;
  }

  .categories-trigger {
    width: 100%;
    justify-content: space-between;
    padding: 12px;
    background: #232f3e;
    border: none;
  }

  /* Search Categories */
  .search_categories_menu {
    min-width: 80px;
  }

  .search_categories_button {
    height: 40px;
    padding: 0 8px;
    white-space: nowrap;
  }

  .search_categories_button__label {
    display: none;
  }

  /* Mobile Navigation */
  .mobile-nav-wrapper {
    width: 100%;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 1000;
    background: #fff;
  }

  .mobile-nav {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* Sidebar Menu */
  .amazon-sidebar {
    width: 85%;
    /* max-width: 350px; */
  }

  

  .submenu {
    width: 100%;
  }

  /* Customer Navigation */
  .customer_nav_button {
    margin: 0 !important;
    padding: 8px;
  }


  /* Header Icons Alignment */
  /* .site-header__icons .site-header__icons-wrapper {
    justify-content: flex-end;
  } */

  /* Search Results */
  .predictive-search-wrapper {
    width: 100%;
    left: 0;
    right: 0;
  }

  /* Top Navigation Links */
  .top_navigation_menu,
  .top_navigation_links {
    flex-direction: column;
    gap: 5px;
    padding: 10px;
  }

  /* Fix for nested menus */
  .mobile-nav__dropdown {
    position: fixed;
    top: 0;
    left: 100%;
    width: 100%;
    height: 100%;
    background: #fff;
    transition: transform 0.3s ease;
    z-index: 1001;
  }

  .mobile-nav__dropdown.is-active {
    transform: translateX(-100%);
  }

  /* Utility Classes */
  .small--hide {
    display: none !important;
  }

  .small--show {
    display: block !important;
  }

  /* Fix for search bar width */
  .site-header .header_top__wrapper .site-header__icons .search-bar__interior {
    max-width: 100% !important;
  }
}

/* Additional fixes for extra small devices */
@media screen and (max-width: 374px) {
  .search_categories_menu {
    min-width: 60px;
  }
}
  /* .search-button__submit {
    padding: 0 10px;
  } */

  .site-header__icons-wrapper {
    gap: 5px;
  }
}

/* Fix for medium-sized devices */
@media screen and (min-width: 750px) and (max-width: 989px) {
  .logo_element-wrapper {
    min-width: auto !important;
  }
}

  @media screen and (max-width: 749px) {
  /* Hide search bar on mobile */
  .site-header__icons .search-bar__interior {
    display: none;
  }
 .site-header .header_top__wrapper .site-header__icons-wrapper .header_cart_info {
    max-width: 45px;
    background-color: unset;
    border: 0;
    position: absolute;
    top: 20%;
}
  /* Center logo on mobile */
  .logo_element-wrapper {
    text-align: center;
    width: 100% !important;
    max-width: 100% !important;
    padding: 10px 0;
  }
  
  .header_top__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .site-header__icons {
    width: auto;
    padding: 10px;
  }

  .logo_element {
    display: flex;
    justify-content: center;
  }

  .logo_element img {
    margin: 0 auto;
  }
  /*  search result */
.search-result-item {
  padding: 10px;
  border-bottom: 1px solid #eee;
}

.search-result-item a {
  display: flex;
  gap: 15px;
  text-decoration: none;
  color: inherit;
}

.search-result-image img {
  width: 60px;
  height: 60px;
  object-fit: cover;
}

.search-result-info {
  flex: 1;
}

.search-result-title {
  font-weight: 500;
  margin-bottom: 5px;
}

.search-result-price {
  color: #B12704;
  font-size: 0.9em;
}

.no-results {
  padding: 20px;
  text-align: center;
  color: #666;
}

</style>
<style data-shopify>.top-bar {
  background-color: #d9d9d6;
  padding: 8px 0;
  font-size: 13px;
  color: #fff;
  border-bottom: 1px solid #484848;
}

.top-bar__container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1490px;
  margin: 0 auto;
  padding: 0 15px;
}

.top-bar__contact-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #000;
  text-decoration: none;
  transition: color 0.2s ease;
  font-size: 13px;
  position: relative;
  font-weight: 700;
}

.top-bar__contact-item:hover {
  color: #c8112e;
}

.top-bar__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  position: relative;
}

.top-bar__icon svg {
  width: 14px;
  height: 14px;
  stroke-width: 1.5;
}

/* Email icon animation */
.top-bar__contact-item:hover .email-icon {
  animation: emailWiggle 0.8s ease-in-out;
}

@keyframes emailWiggle {
  0%, 100% { transform: rotate(0); }
  25% { transform: rotate(-10deg); }
  75% { transform: rotate(10deg); }
}

/* Phone icon animation */
.top-bar__contact-item:hover .phone-icon {
  animation: phoneRing 0.8s ease-in-out;
}

@keyframes phoneRing {
  0%, 100% { transform: rotate(0); }
  10%, 30%, 50%, 70%, 90% { transform: rotate(-5deg); }
  20%, 40%, 60%, 80% { transform: rotate(5deg); }
}

/* Icon pulse effect */
.top-bar__contact-item::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: rgba(254, 189, 105, 0.1);
  border-radius: 4px;
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.3s ease;
}

.top-bar__contact-item:hover::after {
  opacity: 1;
  transform: scale(1);
}

@media screen and (max-width: 749px) {
  .top-bar__container {
   // flex-direction: column;
    gap: 8px;
    text-align: center;
  }
  
  .top-bar__contact-item {
    justify-content: center;
  }
   .site-header .site-header__icons .search-bar__interior .search-form__container {
    visibility: visible;
    opacity: 1;
    position: relative;
    margin-top: 0px;
    pointer-events: all;
}
  .site-header.logo--left .header_top__wrapper .site-header__icons-wrapper .search-bar__interior .header-search-button{
    display: none;
  }
}</style>












