# Server-only ScrapeGraphAI managed API key. Never expose this as NEXT_PUBLIC_*.
SGAI_API_KEY=

# HOVIN / Clerk (mobile). Publishable key is public; never put the Clerk secret in EXPO_PUBLIC_*.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_HOVIN_API_ORIGIN=https://www.hotelsvendors.com
EXPO_PUBLIC_HOVIN_VISUAL_REVIEW=0

# EAS cloud builds (CI / agent). Prefer Expo dashboard token over interactive login.
EXPO_TOKEN=

# Web /hovin store badges — set only after verified TestFlight / Play URLs exist.
NEXT_PUBLIC_IOS_DOWNLOAD_URL=
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=

# Optional App Store Connect helpers for `eas submit`
ASC_APP_ID=
APPLE_ID=
APPLE_TEAM_ID=
