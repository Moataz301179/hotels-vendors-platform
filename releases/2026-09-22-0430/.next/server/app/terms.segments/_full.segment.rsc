1e:["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white mb-3","children":"4. Account Registration and KYC"}],["$","p",null,{"children":"4.1. To use the Services, you must register an account and provide accurate, complete information as required by our Know Your Customer (KYC) procedures."}],["$","p",null,{"children":"4.2. The Platform implements a three-tier KYC verification process in compliance with Egyptian Anti-Money Laundering Law (Law No. 80 of 2002, as amended 2020):"}],["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Level 1:"}]," Email and phone verification."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Level 2:"}]," Tax ID and business license verification."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Level 3:"}]," Bank account verification."]}]]}],["$","p",null,{"className":"mt-3","children":"4.3. Failure to complete required KYC levels may restrict your access to certain Platform features, including factoring referral services."}],["$","p",null,{"children":"4.4. You are responsible for maintaining the confidentiality of your account credentials and for all activities that occur under your account."}]]}]
1f:["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white mb-3","children":"5. Orders and Transactions"}],["$","p",null,{"children":"5.1. All orders placed through the Platform are direct agreements between the Hotel (buyer) and the Supplier (seller). The Platform facilitates but is not a party to these transactions."}],["$","p",null,{"children":"5.2. The Platform charges the following fees:"}],["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Marketplace Commission:"}]," 1.5%–3% on completed transactions."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Document Processing Fee:"}]," Per ETA invoice submission."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Supplier SaaS Fee:"}]," Subscription for INVO marketplace listing plans."]}]]}],["$","p",null,{"className":"mt-3","children":"5.3. The Platform does NOT charge factoring fees, interest, or financial spreads. Factoring fees are charged exclusively by licensed factoring partners."}]]}]
20:["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white mb-3","children":"6. Dispute Resolution"}],["$","p",null,{"children":"6.1. The Platform provides a dispute resolution mechanism for transactions conducted through the Platform. Disputes may be initiated by either party (Hotel or Supplier) within 30 days of the transaction date."}],["$","p",null,{"children":"6.2. Dispute resolution process:"}],["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Step 1 — Direct Negotiation:"}]," Parties attempt to resolve the dispute directly through Platform messaging."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Step 2 — Platform Mediation:"}]," If unresolved, the Platform mediates between parties within 5 business days."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Step 3 — CPA Escalation:"}]," For disputes exceeding EGP 50,000 or involving quality/safety issues, the matter may be escalated to the Egyptian Consumer Protection Agency (CPA)."]}]]}],["$","p",null,{"className":"mt-3","children":"6.3. The Platform reserves the right to assign liability (Hotel, Supplier, Logistics Provider, Platform, or Split Liability) based on evidence and investigation."}]]}]
21:["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white mb-3","children":"7. Return Policy"}],["$","p",null,{"children":"7.1. Suppliers may set their own return policies, with a minimum of 14 days for most product categories as required by Egyptian Consumer Protection Law (Law No. 181 of 2018)."}],["$","p",null,{"children":"7.2. Return requests must be submitted through the Platform's return merchandise authorization (RMA) workflow."}]]}]
